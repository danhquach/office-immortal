{
  "name": "office-immortal",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "zip": "node tools/zip-build.mjs",
    "check:no-debug": "node tools/no-debug.mjs",
    "check:version": "git fetch --quiet --no-tags origin main && node tools/version-check.mjs bump FETCH_HEAD",
    "marketing:saves": "node --experimental-strip-types tools/marketing/saves.ts",
    "marketing:screenshots": "node --experimental-strip-types tools/marketing/screenshots.ts",
    "marketing:trailer": "node --experimental-strip-types tools/marketing/trailer.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "playwright": "1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
