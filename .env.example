# Cloud save (optional). Leave both empty and the build has no cloud save at all.
# Copy to .env (git-ignored) for local builds; in CI they are GitHub Actions
# variables. Both values are public by design (they ship in the page); see
# supabase/README.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage frame (docs/design.md §11, "Cloud save on itch.io"); both public.
# GitHub Pages build: the itch.io page the frame answers, https://<user>.itch.io.
VITE_ITCH_PAGE_ORIGIN=
# itch.io build only: the frame page, https://<user>.github.io/<repo>/store.html.
# Set it only for the itch.io build; the GitHub Pages build must leave it empty.
VITE_STORE_FRAME_URL=
